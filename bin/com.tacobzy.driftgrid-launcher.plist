<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tacobzy.driftgrid-launcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/tacobzy/repos/driftgrid/bin/driftgrid-launcher.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/tacobzy/repos/driftgrid</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/tmp/driftgrid-launcher.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/driftgrid-launcher.stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/tacobzy</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>DRIFTGRID_IDLE_MINUTES</key>
    <string>30</string>
  </dict>
</dict>
</plist>
